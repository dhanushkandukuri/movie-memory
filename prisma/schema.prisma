generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // null until the user finishes onboarding
  favoriteMovie String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  facts              MovieFact[]
  factGenerationLock FactGenerationLock?
}

// Account and Session are the tables @auth/prisma-adapter reads and writes.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MovieFact {
  id         String   @id @default(cuid())
  userId     String
  // Title as it was when the fact was generated. Facts are looked up by
  // (userId, movieTitle), so changing the favorite movie never returns a
  // fact written for the old one.
  movieTitle String   @db.VarChar(100)
  content    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, movieTitle, createdAt(sort: Desc)])
}

// At most one fact generation per user at a time. A row exists only while a
// request is calling OpenAI; other requests see it and wait for that result
// instead of starting their own call. `expiresAt` makes the lock a lease, so a
// crashed or timed-out request can't block the user forever.
model FactGenerationLock {
  userId    String   @id
  // random id per request, so a request can only ever release its own lock
  token     String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
